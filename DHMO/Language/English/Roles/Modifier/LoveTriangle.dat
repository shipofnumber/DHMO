# Assignable

"role.loveTriangle.name" : "Triangle"
"role.loveTriangle.generalBlurb" : "A Love Triangle Has Stability"

# Document

"role.loveTriangle.doc" : "A modifier for pairs of 3. If your one of partners dies, you die following them."
"role.loveTriangle.winCond" : "Survive with your partners when the total number of survivors is 5 or less.<br>The Triangle can only <b>solo win</b>, not by the role."
"role.loveTriangle.tips" : "・The role is created by <b>DHMO</b>."

# Options

"options.role.loveTriangle.detail" : "While the number of ways to win increases, so does the risk of death."
