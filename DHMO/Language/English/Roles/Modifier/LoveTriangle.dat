"options.loveTriangle.involveInactiveTurns" : "Involve Inactive Turns"
"options.loveTriangle.involveInactiveTurns.detail" : "Starting from the turn when a Triangle forms, the ability will become inactive after the current turn count exceeds the option turn count."
"options.loveTriangle.sealUntilSecondTurn" : "Seal Ability Until Second Turn" 
"options.loveTriangle.sealUntilSecondTurn.detail" : "Starting from the turn when a Triangle forms, the ability cannot be used until the second turn."
"options.loveTriangle.meetingChat" : "Meeting Chat"

